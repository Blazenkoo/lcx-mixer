{
  "manifest_version": 3,
  "name": "LCX Mixer",
  "version": "1.0.0",
  "description": "Connects Chrome tabs to the LCX Mixer app and the Launch Control XL.",
  "key": "",
  "permissions": ["tabs", "nativeMessaging", "scripting", "favicon"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["isolated.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": { "default_title": "LCX Mixer" }
}
